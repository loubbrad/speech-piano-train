Bootstrap: docker
From: nvidia/cuda:12.6.3-cudnn-devel-ubuntu24.04

%files
    pyproject.toml /workspace/speech-piano-train/pyproject.toml
    uv.lock /workspace/speech-piano-train/uv.lock

%post
    set -eu
    chmod 1777 /tmp
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y -o Dpkg::Use-Pty=0 --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        python3 \
        python3-dev
    rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/install.sh \
        | env UV_INSTALL_DIR=/usr/local/bin sh

    export UV_PROJECT_ENVIRONMENT=/opt/speech-piano/.venv
    export MAX_JOBS=8
    export CAUSAL_CONV1D_FORCE_BUILD=TRUE
    cd /workspace/speech-piano-train
    uv sync --frozen --no-dev --extra cuda-ext --no-install-project \
        --no-binary-package causal-conv1d
    uv cache clean

%environment
    export PATH=/opt/speech-piano/.venv/bin:/usr/local/bin:$PATH

%test
    /opt/speech-piano/.venv/bin/python -c \
        "import causal_conv1d, torch; from transformers import Qwen3_5ForCausalLM"
